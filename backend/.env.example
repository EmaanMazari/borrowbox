# BookBazar Environment Configuration

# Django Core
SECRET_KEY=django-insecure-bookbazar-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
# To use PostgreSQL, set DB_ENGINE=django.db.backends.postgresql and configure credentials:
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=bookbazar_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Platform Contact Unlock Settings
CONTACT_UNLOCK_FEE_PKR=100.00
PLATFORM_JAZZ_CASH_ACCOUNT=03001234567
PLATFORM_EASYPAISA_ACCOUNT=03121234567
PLATFORM_ACCOUNT_TITLE=BookBazar Platform Official

# Future Payment Gateway Credentials (JazzCash)
JAZZ_CASH_MERCHANT_ID=
JAZZ_CASH_PASSWORD=
JAZZ_CASH_INTEGER_KEY=
JAZZ_CASH_RETURN_URL=http://localhost:5173/payment/callback/jazzcash

# Future Payment Gateway Credentials (Easypaisa)
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_RETURN_URL=http://localhost:5173/payment/callback/easypaisa

# Future Image Recognition / AI API Keys
GOOGLE_VISION_API_KEY=
OPENAI_OR_GEMINI_API_KEY=
